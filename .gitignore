# Rust build output (workspace at repo root)
/target
**/*.rs.bk

# glass-fixture-egui is excluded from the workspace (heavy egui deps), so it builds into its
# own target/ (the first-drive tutorial has the agent build it). Its Cargo.lock is tracked.
/crates/glass-fixture-egui/target/

# glass working dir created in target projects
.glass/

# Profiling output (cargo-flamegraph / perf write these to the CWD)
flamegraph.svg
perf.data
perf.data.old

# Coverage output (cargo-llvm-cov)
*.profraw

# cargo-mutants default output dir (root or a crate subdirectory)
mutants.out/
mutants.out.old/

# Editor / OS cruft
*.swp
.DS_Store
.idea/

# Pulled-back artifacts from scripts/test-windows.sh on-box runs
/.windows-artifacts/

# Fixture cruft
**/__pycache__/

# Build output from the examples' build.sh — .app bundles (iOS) and the APK (Android)
/examples/*/build/
# The Android role fixture's throwaway signing key, generated on first build. It lives outside
# build/ so rebuilds keep signing with the same key; see that example's build.sh.
/examples/android-role-fixture/.signing-key.jks

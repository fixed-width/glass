{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fixed-width/glass/tools/interaction-bench/run.schema.json",
  "title": "Interaction benchmark run manifest, version 1",
  "type": "object",
  "required": [
    "schema_version",
    "recipe_revision",
    "config",
    "configuration_sha256",
    "schedule",
    "preflight",
    "created_utc",
    "host",
    "identities",
    "fixture_files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "recipe_revision": {
      "type": "integer",
      "minimum": 1
    },
    "config": {
      "$ref": "#/$defs/config"
    },
    "configuration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "schedule": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cell"
      }
    },
    "preflight": {
      "type": "object"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object",
      "required": [
        "system",
        "machine",
        "node"
      ]
    },
    "identities": {
      "type": "object"
    },
    "fixture_files": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/file"
      }
    },
    "source_files": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "file": {
      "type": "object",
      "required": [
        "sha256",
        "bytes"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "case": {
      "enum": [
        "large-form",
        "disabled",
        "duplicate",
        "scoped",
        "delayed",
        "moving",
        "occluded",
        "occluded-distinct",
        "mutation",
        "iframe",
        "cross-origin",
        "artifact",
        "electron-form",
        "android-boundary",
        "native-form",
        "cross-application"
      ]
    },
    "cell": {
      "type": "object",
      "required": [
        "case",
        "driver",
        "iteration",
        "warmup"
      ],
      "properties": {
        "case": {
          "$ref": "#/$defs/case"
        },
        "driver": {
          "type": "string"
        },
        "iteration": {
          "type": "integer",
          "minimum": 0
        },
        "warmup": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "required": [
        "schema_version",
        "browser",
        "browser_family",
        "drivers",
        "cases",
        "repetitions",
        "warmups",
        "seed"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "browser": {
          "type": [
            "string",
            "null"
          ]
        },
        "browser_family": {
          "enum": [
            "firefox",
            "chromium"
          ]
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/case"
          }
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "warmups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "drivers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "adapter",
              "command"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "adapter": {
                "type": "string"
              },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "optional_cases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/case"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "driver",
              "case",
              "reason"
            ],
            "properties": {
              "driver": {
                "type": "string"
              },
              "case": {
                "$ref": "#/$defs/case"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "applications": {
          "type": "object",
          "description": "Configured native executable, packaged Electron bundle, or Android SDK/image/APK and companion paths."
        }
      }
    },
    "attempt": {
      "type": "object",
      "required": [
        "case",
        "driver",
        "iteration",
        "warmup",
        "outcome",
        "files",
        "wall_ms"
      ],
      "properties": {
        "case": {
          "$ref": "#/$defs/case"
        },
        "driver": {
          "type": "string"
        },
        "iteration": {
          "type": "integer",
          "minimum": 0
        },
        "warmup": {
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "task_completed",
            "expected_refusal",
            "failed",
            "unsupported",
            "skipped",
            "harness_error"
          ]
        },
        "cleanup_ok": {
          "type": "boolean"
        },
        "evidence_ok": {
          "type": "boolean"
        },
        "wall_ms": {
          "type": "number",
          "minimum": 0
        },
        "events": {
          "type": "array"
        },
        "phases": {
          "type": "object"
        },
        "artifacts": {
          "type": "object"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/file"
          }
        },
        "participants": {
          "type": "object",
          "description": "Application channels, each with its own wire ledger, inventory, events and artifacts. Parent costs sum all channels.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "kind",
              "events",
              "files"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "native",
                  "electron",
                  "android"
                ]
              },
              "events": {
                "type": "array"
              },
              "artifacts": {
                "type": "object"
              },
              "files": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/file"
                }
              }
            }
          }
        }
      }
    }
  }
}
